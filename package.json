    "web-audio-beat-detector": "8.2.39"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^6.0.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
  }
}
